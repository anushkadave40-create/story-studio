# ==============================================================================
# STORY STUDIO - 100% FREE LOCAL CONFIGURATION
# ==============================================================================
# Story Studio is completely free and runs 100% locally.
# It does NOT call any paid or hosted AI APIs, and requires no API keys or billing.

# ------------------------------------------------------------------------------
# 1. Local Script Generation via Ollama (Free & Open-Source)
# Install Ollama from https://ollama.com
# Start your local model with: ollama run llama3.2
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. Local Video Generation via ComfyUI (Free & Open-Source)
# Install ComfyUI from https://github.com/comfyanonymous/ComfyUI
# Recommended open-source video models: LTX-Video, Wan2.1, or AnimateDiff
# Run ComfyUI locally with: python main.py
# ------------------------------------------------------------------------------
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Note: If Ollama is not running, Story Studio automatically falls back to offline
# Demo Mode and clearly labels generated scripts as sample/demo outputs.
# Video generation requires local ComfyUI to be active before generating video.
